# Copy to .streamlit/secrets.toml (git-ignored) or paste into
# Streamlit Community Cloud → App → Settings → Secrets.
#
# Supabase → Project → Connect → "Session pooler" connection string (IPv4-compatible).
# Replace [YOUR-PASSWORD] with your database password. Keep sslmode=require.
DATABASE_URL = "postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
